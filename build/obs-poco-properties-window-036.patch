+#!/usr/bin/env python3
+"""Android source properties dialog layout regression."""
+from pathlib import Path
+root=Path(__file__).resolve().parents[1]
+s=(root/"obs-studio/frontend/dialogs/OBSBasicProperties.cpp").read_text()
+manifest=(root/"obs-studio/frontend/cmake/android/AndroidManifest.xml").read_text()
+assert 'android:versionCode="33"' in manifest
+assert 'android:versionName="0.3.6-poco"' in manifest
+assert 'ui->previewFrame->hide()' in s
+assert 'const bool allowEmbeddedPreview = false;' in s
+assert 'const bool allowEmbeddedPreview = true;' in s
+assert 'if (allowEmbeddedPreview && drawable_preview && drawable_type)' in s
+assert 'else if (allowEmbeddedPreview && type == OBS_SOURCE_TYPE_TRANSITION)' in s
+assert 'view->setMinimumHeight(72);' in s
+assert 'setMaximumSize(qMax(240, usable.width() - 16)' in s
+assert s.count('androidFitTopLevelToScreen(this);') >= 3
+assert '#ifndef __ANDROID__\n\tobs_display_remove_draw_callback(ui->preview->GetDisplay()' in s
+assert 'obsAndroidPreviewVisibilityChanged();' in s
+print("PASS Android source properties: no second preview and bounded touch controls")
