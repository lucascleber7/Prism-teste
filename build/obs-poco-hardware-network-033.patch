@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+package com.obsproject.studio;
+
+import android.content.Context;
+import android.net.ConnectivityManager;
+import android.net.Network;
+import android.net.NetworkCapabilities;
+import android.os.Build;
+
+/**
+ * Read-only, lightweight diagnostics. Estimated bandwidth from Android
+ * NetworkCapabilities is link information, not a speedtest or ISP guarantee.
+ * Live RTMP transmission rate is separately measured by libobs.
+ */
+public final class ObsNetworkStatus {
+    private ObsNetworkStatus() {}
+
+    public static String snapshot(Context context) {
+        if (context == null) return "indisponível|0|0|0";
+        try {
+            ConnectivityManager manager =
+                (ConnectivityManager) context.getSystemService(Context.CONNECTIVITY_SERVICE);
+            if (manager == null) return "indisponível|0|0|0";
+            Network network = manager.getActiveNetwork();
+            if (network == null) return "desconectado|0|0|0";
+            NetworkCapabilities caps = manager.getNetworkCapabilities(network);
+            if (caps == null) return "indisponível|0|0|0";
+            String transport;
+            if (caps.hasTransport(NetworkCapabilities.TRANSPORT_ETHERNET)) transport = "USB/Ethernet";
+            else if (caps.hasTransport(NetworkCapabilities.TRANSPORT_WIFI)) transport = "Wi-Fi";
+            else if (caps.hasTransport(NetworkCapabilities.TRANSPORT_CELLULAR)) transport = "Móvel";
+            else if (caps.hasTransport(NetworkCapabilities.TRANSPORT_VPN)) transport = "VPN";
+            else transport = "outra";
+            int up = Math.max(0, caps.getLinkUpstreamBandwidthKbps());
+            int valid = caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_VALIDATED) ? 1 : 0;
+            int metered = caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_NOT_METERED) ? 0 : 1;
+            return transport + "|" + up + "|" + valid + "|" + metered;
+        } catch (RuntimeException ex) {
+            return "sem permissão|0|0|0";
+        }
+    }
+}
