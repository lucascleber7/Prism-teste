+#!/usr/bin/env python3
+"""OBS POCO Android 0.3.3 integration: network and encoder observability."""
+from pathlib import Path
+r=Path(__file__).resolve().parents[1]
+manifest=(r/"obs-studio/frontend/cmake/android/AndroidManifest.xml").read_text()
+java=(r/"obs-studio/frontend/cmake/android/java/com/obsproject/studio/ObsNetworkStatus.java").read_text()
+codec=(r/"obs-studio/frontend/cmake/android/java/com/obsproject/studio/ObsCodecCapabilities.java").read_text()
+bar=(r/"obs-studio/frontend/widgets/OBSBasicStatusBar.cpp").read_text()
+main=(r/"obs-studio/frontend/widgets/OBSBasic.cpp").read_text()
+assert 'android.permission.ACCESS_NETWORK_STATE' in manifest
+assert 'versionCode="30"' in manifest
+assert 'versionName="0.3.3-poco"' in manifest
+assert 'getActiveNetwork()' in java
