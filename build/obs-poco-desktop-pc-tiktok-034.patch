@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+"""Verify that OBS Studio PC link sources remain usable on Android."""
+from pathlib import Path
+r = Path(__file__).resolve().parents[1]
+basic = (r/"obs-studio/frontend/widgets/OBSBasic.cpp").read_text()
+drop = (r/"obs-studio/frontend/widgets/OBSBasic_Dropfiles.cpp").read_text()
+scenes = (r/"obs-studio/frontend/widgets/OBSBasic_SceneCollections.cpp").read_text()
+manifest = (r/"obs-studio/frontend/cmake/android/AndroidManifest.xml").read_text()
+assert 'versionCode="31"' in manifest
+assert 'versionName="0.3.4-poco"' in manifest
+assert 'android:debuggable="false"' in manifest
+assert 'OBS PC / LIVE Studio: adicionar overlay por link' in basic
+assert 'QInputDialog::getText(' in basic
+assert 'url.scheme() != QLatin1String("https")' in basic
+assert 'url.scheme() != QLatin1String("http")' in basic
+assert 'obs_source_get_display_name("android_browser_source")' in basic
+assert 'AddDropSource(encodedUrl.constData(), DropType_Url)' in basic
+assert 'browser_source' in drop and 'android_browser_source' in drop
+assert '#ifdef __ANDROID__\n        // OBS desktop' in drop
+assert 'obs_data_set_int(settings, "fps", 30)' in drop
+assert 'const size_t count = obs_data_array_count(sources)' in scenes
+assert 'strcmp(id, "browser_source") == 0' in scenes
+assert 'strcmp(versionedId, "browser_source") == 0' in scenes
+assert 'obs_data_set_string(source, "id", "android_browser_source")' in scenes
+assert 'obs_data_set_string(source, "versioned_id", "android_browser_source")' in scenes
+assert 'obs_data_get_obj(source, "settings")' in scenes
+assert 'obs_data_get_string(source, "url")' not in scenes  # URL data never logged
+assert 'obs_data_set_string(settings, "url"' not in scenes  # preserve original secrets and source URL
+print("PASS: OBS PC URL overlay, Android source alias, scene migration, debug hardening")
