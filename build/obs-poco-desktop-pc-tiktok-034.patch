+#ifdef __ANDROID__
+    // The official PC OBS scene files record browser layers as browser_source.
+    // On Android our available backend is android_browser_source (WebView).
+    // Migrate in memory before obs_load_sources() so OWN3D/TikFinity web
+    // overlays survive importing a desktop scene collection. Do not remap
+    // Linux PulseAudio/XSHM sources to unrelated Android devices.
+    size_t mappedBrowsers = 0;
+    if (sources && obs_source_get_display_name("android_browser_source")) {
+        const size_t count = obs_data_array_count(sources);
+        for (size_t i = 0; i < count; ++i) {
+            OBSDataAutoRelease source = obs_data_array_item(sources, i);
+            if (!source)
+                continue;
+            const char *id = obs_data_get_string(source, "id");
+            const char *versionedId = obs_data_get_string(source, "versioned_id");
+            if ((id && strcmp(id, "browser_source") == 0) ||
+                (versionedId && strcmp(versionedId, "browser_source") == 0)) {
+                obs_data_set_string(source, "id", "android_browser_source");
+                obs_data_set_string(source, "versioned_id", "android_browser_source");
+                OBSDataAutoRelease settings = obs_data_get_obj(source, "settings");
+                if (settings && !obs_data_has_user_value(settings, "fps"))
+                    obs_data_set_int(settings, "fps", 30);
+                ++mappedBrowsers;
+            }
+        }
+    }
+    if (mappedBrowsers)
+        blog(LOG_INFO, "[POCO-desktop-import] browser sources converted to Android WebView: %zu",
+             mappedBrowsers);
+#endif
 
 	bool resetVideo = false;
 	obs_video_info ovi;
