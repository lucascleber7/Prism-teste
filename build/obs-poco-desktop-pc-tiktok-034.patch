 #include <graphics/graphics.h>
 #endif
 #include <QCoreApplication>
@@ -1124,6 +1127,51 @@ void OBSBasic::OBSInit()
 		throw "Failed to load basic.ini";
 	}
 #ifdef __ANDROID__
+    // OBS PC and LIVE Studio both support pasting a web link as a scene
+    // layer. Reuse OBS desktop's full undo/redo source pipeline but map the
+    // CEF browser type to Android WebView (no CEF, no extra process).
+    QAction *pocoAddOverlay = ui->menuTools->addAction(
+        QStringLiteral("OBS PC / LIVE Studio: adicionar overlay por link"));
+    connect(pocoAddOverlay, &QAction::triggered, this, [this] {
+        if (!GetCurrentScene()) {
+            QMessageBox::warning(this, QStringLiteral("Nenhuma cena selecionada"),
+                                 QStringLiteral("Crie ou selecione uma cena antes de adicionar um overlay."));
+            return;
+        }
+        bool accepted = false;
+        const QString pasted = QInputDialog::getText(
+            this, QStringLiteral("Adicionar fonte por link"),
+            QStringLiteral("Cole o link HTTPS do seu overlay (TikFinity, OWN3D, VDO.Ninja etc.):"),
+            QLineEdit::Normal, QString(), &accepted).trimmed();
+        if (!accepted || pasted.isEmpty())
+            return;
+        const QUrl url = QUrl::fromUserInput(pasted);
+        if (!url.isValid() ||
+            (url.scheme() != QLatin1String("https") && url.scheme() != QLatin1String("http")) ||
+            url.host().isEmpty()) {
+            QMessageBox::warning(this, QStringLiteral("URL inválida"),
+                                 QStringLiteral("Use um link HTTP ou HTTPS completo. "
+                                                "Não informe senha de conta nem chave RTMP aqui."));
+            return;
+        }
+        if (!obs_source_get_display_name("android_browser_source")) {
+            QMessageBox::warning(this, QStringLiteral("Fonte de navegador indisponível"),
+                                 QStringLiteral("O plugin Android WebView não carregou. "
+                                                "Verifique os plugins e o log do OBS."));
+            return;
+        }
+        // AddDropSource creates a unique source name, attaches it to the
+        // active scene and registers undo/redo. Do not log URL tokens.
+        const QByteArray encodedUrl = url.toString(QUrl::FullyEncoded).toUtf8();
+        AddDropSource(encodedUrl.constData(), DropType_Url);
+        blog(LOG_INFO, "[POCO-overlay] Android WebView source requested for current scene");
+        QMessageBox::information(this, QStringLiteral("Overlay adicionado"),
+            QStringLiteral("O link foi enviado à fonte Navegador Android. "
+                           "Verifique a imagem na prévia e ajuste tamanho/transparência "
+                           "nas propriedades. Áudio de páginas WebView ainda não "
+                           "é enviado ao mixer do OBS."));
+    });
+
     // Existing profiles can pin x264 even when MediaCodec becomes available.
     // Switching the combobox is not enough: rebuild the output when idle,
     // and report the actual encoder attached to the running stream.
