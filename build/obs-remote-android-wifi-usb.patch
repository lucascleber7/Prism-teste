diff --git a/scripts/test-android-remote-source.py b/scripts/test-android-remote-source.py
new file mode 100644
index 0000000..0d6be93
--- /dev/null
+++ b/scripts/test-android-remote-source.py
@@ -0,0 +1,24 @@
+#!/usr/bin/env python3
+"""Checks that the native Android remote-receiver source stays wired to FFmpeg."""
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1]
+ff=(ROOT/"obs-studio/plugins/obs-ffmpeg/obs-ffmpeg-source.c").read_text()
+mod=(ROOT/"obs-studio/plugins/obs-ffmpeg/obs-ffmpeg.c").read_text()
+must={
+    "unique source":'.id = "android_remote_source"',
+    "non-file media":'obs_data_set_default_bool(settings, "is_local_file", false)',
+    "hardware codec":'obs_data_set_default_bool(settings, "hw_decode", true)',
+    "low reconnection":'obs_data_set_default_int(settings, "reconnect_delay_sec", 2)',
+    "UDP listen port":'udp://@:12345',
+    "media source lifecycle":'.create = ffmpeg_source_create',
+    "media network retry":'.video_tick = ffmpeg_source_tick',
+    "render and audio":'OBS_SOURCE_ASYNC_VIDEO | OBS_SOURCE_AUDIO',
+    "no ADB dependency":'o cabo sozinho não envia vídeo',
+    "RTMP listener":'ffmpeg_options = "rtmp_listen=1";',
+    "RTMP receiver URL":'rtmp://0.0.0.0:19350/live/screen',
+}
+for name, token in must.items():
+    assert token in ff, f"{name} missing"
+assert mod.count("obs_register_source(&android_remote_source)") == 1
+assert "extern struct obs_source_info android_remote_source;" in mod
+print("PASS: Android screen receiver uses FFmpeg, MediaCodec and USB/IP transport")
