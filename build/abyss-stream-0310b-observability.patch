+#!/usr/bin/env python3
+"""Abyss Stream 0.3.10b: evidence for slow lives, black previews and unexpected closes."""
+from pathlib import Path
+
+r = Path(__file__).resolve().parents[1]
+java = r / "obs-studio/frontend/cmake/android/java/com/obsproject/studio"
+diag = (java / "ObsCrashDiag.java").read_text()
+app = (r / "obs-studio/frontend/OBSApp.cpp").read_text()
+
+# Performance samples: thermal state, battery, memory, own PSS; flushed to Downloads.
+assert "startMonitor(app);" in diag
+assert "getCurrentThermalStatus()" in diag
+assert "Intent.ACTION_BATTERY_CHANGED" in diag
+assert "Debug.getPss()" in diag
+assert "ABYSS_STREAM_desempenho.txt" in diag
+assert "MONITOR_INTERVAL_MS = 15000L" in diag
+
+# OBS log mirrored to Downloads: found under obs-studio/logs, tail only, rewritten in place.
+assert '"logs".equals(kid.getName()) && "obs-studio".equals(dir.getName())' in diag
+assert "ABYSS_STREAM_log_" in diag
+assert "MAX_LOG_BYTES = 1500000" in diag
+assert 'resolver.openOutputStream(uri, "wt")' in diag
+assert "private static boolean writeDownload(Context app, String name, byte[] data, boolean overwrite)" in diag
+
+# The monitor thread can never take the app down.
+assert "monitor.setDaemon(true);" in diag
+assert "catch (Throwable t) {\n                        Log.w(TAG, \"monitor tick failed\", t);" in diag
+
+# Preview visibility: say which window covers the preview, only when the state changes.
+assert "const QWidget *coverer = nullptr;" in app
+assert "coverer = w;" in app
+assert "static bool lastCovered = false;" in app
+assert "[POCO-preview] previa %s; janela que cobre: %s '%s'" in app
+
+print("PASS Abyss Stream 0.3.10b: performance samples, OBS log mirror, preview cover log")
