+    /**
+     * Every 15 s: sample thermal state, battery, memory. Every minute: write the samples and a copy of
+     * the OBS log to Downloads, so a slow or black live can be explained afterwards even if the app
+     * was killed. The logs are the app's own; no stream key is written by OBS to them.
+     */
+    private static void startMonitor(final Context app) {
+        Thread monitor = new Thread(new Runnable() {
+            @Override
+            public void run() {
+                int tick = 0;
+                try {
+                    mirrorLogs(app);
+                } catch (Throwable ignored) {
+                    // First copy is best effort.
+                }
+                while (true) {
+                    try {
+                        Thread.sleep(MONITOR_INTERVAL_MS);
+                        samplePerf(app);
+                        if (++tick % 4 == 0) {
+                            flushPerf(app);
+                            mirrorLogs(app);
+                        }
+                    } catch (InterruptedException e) {
+                        return;
+                    } catch (Throwable t) {
+                        Log.w(TAG, "monitor tick failed", t);
+                    }
+                }
+            }
+        }, "abyss-monitor");
+        monitor.setDaemon(true);
+        monitor.start();
+    }
+
+    private static String thermalName(int status) {
+        switch (status) {
+        case 0: return "normal";
+        case 1: return "LEVE";
+        case 2: return "MODERADO";
+        case 3: return "SEVERO";
+        case 4: return "CRITICO";
+        case 5: return "EMERGENCIA";
+        case 6: return "DESLIGANDO";
+        default: return "?";
+        }
+    }
+
+    private static void samplePerf(Context app) {
+        StringBuilder sb = new StringBuilder(new SimpleDateFormat("HH:mm:ss", Locale.US).format(new Date()));
+        PowerManager power = (PowerManager) app.getSystemService(Context.POWER_SERVICE);
+        if (power != null && Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q)
+            sb.append("  termico=").append(thermalName(power.getCurrentThermalStatus()));
+        Intent battery = app.registerReceiver(null, new IntentFilter(Intent.ACTION_BATTERY_CHANGED));
+        if (battery != null) {
+            sb.append("  bateria=").append(battery.getIntExtra(BatteryManager.EXTRA_LEVEL, -1)).append('%')
+              .append("  temp=").append(battery.getIntExtra(BatteryManager.EXTRA_TEMPERATURE, 0) / 10.0).append("C")
+              .append("  carregando=").append(battery.getIntExtra(BatteryManager.EXTRA_PLUGGED, 0) != 0);
+        }
+        android.app.ActivityManager manager = (android.app.ActivityManager) app.getSystemService(Context.ACTIVITY_SERVICE);
+        if (manager != null) {
+            android.app.ActivityManager.MemoryInfo memory = new android.app.ActivityManager.MemoryInfo();
+            manager.getMemoryInfo(memory);
+            sb.append("  ram_livre_mb=").append(memory.availMem / 1048576L)
+              .append("  memoria_baixa=").append(memory.lowMemory);
+        }
+        sb.append("  app_pss_mb=").append(Debug.getPss() / 1024L);
+        synchronized (perfLines) {
+            perfLines.addLast(sb.toString());
+            while (perfLines.size() > PERF_KEEP) perfLines.removeFirst();
+        }
+    }
+
+    private static void flushPerf(Context app) {
+        StringBuilder sb = new StringBuilder(header(app)).append("\n\nAmostras a cada 15 s (mais recentes no fim):\n");
+        synchronized (perfLines) {
+            for (String line : perfLines) sb.append(line).append('\n');
+        }
+        writeDownload(app, "ABYSS_STREAM_desempenho.txt", sb.toString().getBytes(StandardCharsets.UTF_8), true);
+    }
+
+    private static File findLogDirIn(File dir, int depth) {
+        if (dir == null || depth > 6) return null;
+        File[] kids = dir.listFiles();
+        if (kids == null) return null;
+        for (File kid : kids) {
+            if (kid.isDirectory() && "logs".equals(kid.getName()) && "obs-studio".equals(dir.getName())) return kid;
+        }
+        for (File kid : kids) {
+            String name = kid.getName();
+            if (!kid.isDirectory() || "cache".equals(name) || "code_cache".equals(name) || "lib".equals(name)) continue;
+            File found = findLogDirIn(kid, depth + 1);
+            if (found != null) return found;
+        }
+        return null;
+    }
+
+    private static File locateLogDir(Context app) {
+        if (logDir != null && logDir.isDirectory()) return logDir;
+        long now = System.currentTimeMillis();
+        if (now < nextLogDirSearchMs) return null;
+        nextLogDirSearchMs = now + 60000L;
+        File found = findLogDirIn(app.getFilesDir(), 0);
+        if (found == null) found = findLogDirIn(app.getDataDir(), 0);
+        logDir = found;
+        return found;
+    }
+
+    private static byte[] readTail(File file, int max) {
+        try (RandomAccessFile in = new RandomAccessFile(file, "r")) {
+            long length = in.length();
+            long start = Math.max(0L, length - max);
+            in.seek(start);
+            byte[] data = new byte[(int) (length - start)];
+            in.readFully(data);
+            if (start == 0L) return data;
+            byte[] marker = "[... inicio do log omitido ...]\n".getBytes(StandardCharsets.UTF_8);
+            byte[] joined = new byte[marker.length + data.length];
+            System.arraycopy(marker, 0, joined, 0, marker.length);
+            System.arraycopy(data, 0, joined, marker.length, data.length);
+            return joined;
+        } catch (Throwable t) {
+            return null;
+        }
+    }
+
+    /** Copies the three most recent OBS logs to Downloads (the previous session's log is the interesting one). */
+    private static void mirrorLogs(Context app) {
+        File dir = locateLogDir(app);
+        if (dir == null) return;
+        File[] files = dir.listFiles();
+        if (files == null || files.length == 0) return;
+        Arrays.sort(files, (a, b) -> Long.compare(b.lastModified(), a.lastModified()));
+        SharedPreferences prefs = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        for (int i = 0; i < Math.min(3, files.length); i++) {
+            File file = files[i];
+            if (!file.isFile()) continue;
+            String key = "log_" + file.getName();
+            long length = file.length();
+            if (prefs.getLong(key, -1L) == length) continue;
+            byte[] data = readTail(file, MAX_LOG_BYTES);
+            if (data == null) continue;
+            String name = "ABYSS_STREAM_log_" + file.getName().replaceAll("[^A-Za-z0-9_.-]", "_");
+            if (!name.endsWith(".txt")) name += ".txt";
+            if (writeDownload(app, name, data, true)) prefs.edit().putLong(key, length).apply();
+        }
+    }
+
+    private static Uri findDownload(ContentResolver resolver, String name) {
+        String[] projection = { MediaStore.MediaColumns._ID };
+        String selection = MediaStore.MediaColumns.DISPLAY_NAME + "=? AND " + MediaStore.MediaColumns.RELATIVE_PATH + " LIKE ?";
+        String[] args = { name, Environment.DIRECTORY_DOWNLOADS + "%" };
+        try (Cursor cursor = resolver.query(MediaStore.Downloads.EXTERNAL_CONTENT_URI, projection, selection, args, null)) {
+            if (cursor != null && cursor.moveToFirst())
+                return ContentUris.withAppendedId(MediaStore.Downloads.EXTERNAL_CONTENT_URI, cursor.getLong(0));
+        } catch (Throwable ignored) {
+            // Fall through: a new file is created instead.
+        }
+        return null;
+    }
+
+    /** Writes (or, with overwrite, replaces) a file in public Downloads through MediaStore. */
+    private static boolean writeDownload(Context app, String name, byte[] data, boolean overwrite) {
+        try {
+            ContentResolver resolver = app.getContentResolver();
+            Uri uri = overwrite ? findDownload(resolver, name) : null;
+            if (uri == null) {
+                ContentValues values = new ContentValues();
+                values.put(MediaStore.MediaColumns.DISPLAY_NAME, name);
+                values.put(MediaStore.MediaColumns.MIME_TYPE, "text/plain");
+                values.put(MediaStore.MediaColumns.RELATIVE_PATH, Environment.DIRECTORY_DOWNLOADS);
+                uri = resolver.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, values);
+            }
+            if (uri == null) return false;
+            try (OutputStream out = resolver.openOutputStream(uri, "wt")) {
+                if (out == null) return false;
+                out.write(data);
+            }
+            return true;
+        } catch (Throwable t) {
+            Log.w(TAG, "download write failed: " + name, t);
+            return false;
+        }
+    }
 }
