diff --git a/obs-studio/frontend/widgets/OBSBasic.cpp b/obs-studio/frontend/widgets/OBSBasic.cpp
index 86c6295..d7718b2 100755
--- a/obs-studio/frontend/widgets/OBSBasic.cpp
+++ b/obs-studio/frontend/widgets/OBSBasic.cpp
@@ -870,7 +870,15 @@ bool OBSBasic::InitBasicConfigDefaults()
 
 	config_set_default_bool(activeConfiguration, "Output", "Reconnect", true);
 	config_set_default_uint(activeConfiguration, "Output", "RetryDelay", 2);
+#ifdef __ANDROID__
+    // OBS 32.2.2 on Ubuntu suffered catastrophic RTMP drops when the upload
+    // couldn't sustain the configured bitrate. MediaCodec supports dynamic
+    // bitrate in CBR mode: preserve full-resolution output when possible.
+    config_set_default_bool(activeConfiguration, "Output", "DynamicBitrate", true);
+    config_set_default_uint(activeConfiguration, "Output", "MaxRetries", 100);
+#else
 	config_set_default_uint(activeConfiguration, "Output", "MaxRetries", 25);
+#endif
 
 	config_set_default_string(activeConfiguration, "Output", "BindIP", "default");
 	config_set_default_string(activeConfiguration, "Output", "IPFamily", "IPv4+IPv6");
@@ -1104,6 +1112,21 @@ void OBSBasic::OBSInit()
 	if (!InitBasicConfig()) {
 		throw "Failed to load basic.ini";
 	}
+#ifdef __ANDROID__
+    // Create after the profile loads; profile settings are not yet
+    // initialized in the QWidget constructor.
+    QAction *pocoNetworkAction = ui->menuTools->addAction(
+        QStringLiteral("POCO: adaptar bitrate à internet (próxima live)"));
+    pocoNetworkAction->setCheckable(true);
+    pocoNetworkAction->setChecked(config_get_bool(
+        activeConfiguration, "Output", "DynamicBitrate"));
+    connect(pocoNetworkAction, &QAction::toggled, this, [this](bool enabled) {
+        config_set_bool(activeConfiguration, "Output", "DynamicBitrate", enabled);
+        activeConfiguration.SaveSafe("tmp");
+        blog(LOG_INFO, "[POCO-network] dynamic-bitrate=%s applies-on=next-live",
+             enabled ? "enabled" : "disabled");
+    });
+#endif
 	if (!ResetAudio()) {
 		throw "Failed to initialize audio";
 	}
diff --git a/scripts/test-android-network-optimizations.py b/scripts/test-android-network-optimizations.py
new file mode 100644
index 0000000..96e138c
--- /dev/null
+++ b/scripts/test-android-network-optimizations.py
@@ -0,0 +1,23 @@
+#!/usr/bin/env python3
+"""Regression checks for POCO Android native upload mitigation."""
+from pathlib import Path
+r=Path(__file__).resolve().parents[1]
+obs=(r/"obs-studio/frontend/widgets/OBSBasic.cpp").read_text()
+med=(r/"obs-studio/plugins/android-mediacodec/android-mediacodec.c").read_text()
+rtmp=(r/"obs-studio/plugins/obs-outputs/rtmp-stream.c").read_text()
+web=(r/"obs-studio/frontend/cmake/android/java/com/obsproject/studio/ObsBrowserHost.java").read_text()
+manifest=(r/"obs-studio/frontend/cmake/android/AndroidManifest.xml").read_text()
+assert '#ifdef __ANDROID__\n    // OBS 32.2.2 on Ubuntu' in obs
+assert 'config_set_default_bool(activeConfiguration, "Output", "DynamicBitrate", true)' in obs
+assert 'config_set_default_uint(activeConfiguration, "Output", "MaxRetries", 100)' in obs
+assert 'pocoNetworkAction->setChecked(config_get_bool(' in obs
+assert 'config_set_bool(activeConfiguration, "Output", "DynamicBitrate", enabled)' in obs
+assert 'activeConfiguration.SaveSafe("tmp")' in obs
+assert 'obs_data_set_default_int(s, "rate_mode", 2)' in med
+assert 'OBS_ENCODER_CAP_DYN_BITRATE' in med
+assert 'AMediaCodec_setParameters(e->codec, f)' in med
+assert 'stream->dbr_enabled = dbr_capable && obs_data_get_bool(settings, OPT_DYN_BITRATE)' in rtmp
+assert 'web.getSettings().setMediaPlaybackRequiresUserGesture(false)' in web
+assert 'android:versionCode="29"' in manifest
+assert 'android:versionName="0.3.2-poco"' in manifest
+print("PASS POCO Android 0.3.2 network mitigation and WebView autoplay integration")
