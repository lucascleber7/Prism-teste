@@ -0,0 +1,18 @@
+#!/usr/bin/env python3
+from pathlib import Path
+r=Path(__file__).resolve().parents[1]
+s=(r/"obs-studio/frontend/widgets/OBSBasic.cpp").read_text()
+m=(r/"obs-studio/frontend/cmake/android/AndroidManifest.xml").read_text()
+p=(r/"obs-studio/frontend/dialogs/OBSBasicProperties.cpp").read_text()
+assert "Touch-only canvas editing" in s
+assert "ui->previewTextLayout->insertWidget(0, touchEditor);" in s
+assert 'dock->setProperty("_abyssEditWasVisible", dock->isVisible());' in s
+assert 'dock->setVisible(dock->property("_abyssEditWasVisible").toBool());' in s
+assert "setPreviewScalingWindow();" in s
+assert "zoom->setMinimumSize(44, 40)" in s
+assert 'android:allowBackup="false"' in m
+assert m.count('android:label="Abyss Stream"')==2
+assert 'android:versionCode="34"' in m
+assert 'android:versionName="0.3.7-abyss"' in m
+assert "ui->previewFrame->hide()" in p
+print("PASS: mobile editor controls, dock state, 0.3.6 preview fix, private backup policy")
