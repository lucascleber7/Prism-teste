index 222e403..51df83a 100755
--- a/obs-studio/frontend/widgets/OBSBasic.cpp
+++ b/obs-studio/frontend/widgets/OBSBasic.cpp
@@ -161,6 +161,45 @@ OBSBasic::OBSBasic(QWidget *parent) : OBSMainWindow(parent), undo_s(ui), ui(new
 
 	ui->setupUi(this);
 	ui->previewDisabledWidget->setVisible(false);
+
+#ifdef __ANDROID__
+    // Touch-only canvas editing: reuse existing native preview surface.
+    // No second EGL surface or modal dialog.
+    QPushButton *touchEditor = new QPushButton(QString::fromUtf8("Ampliar edição"), ui->previewContainer);
+    touchEditor->setObjectName(QStringLiteral("abyssTouchEditor"));
+    touchEditor->setCheckable(true);
+    touchEditor->setMinimumHeight(48);
+    touchEditor->setToolTip(QString::fromUtf8("Amplia a prévia para mover imagens; não altera a live"));
+    touchEditor->setStyleSheet(
+        "QPushButton#abyssTouchEditor {color:#eef7ff; background:rgba(20,43,65,225);"
+        " border:1px solid #6d91ae; border-radius:13px; padding:8px 16px; font-weight:600;}"
+        "QPushButton#abyssTouchEditor:checked {background:rgba(69,48,36,230); border:2px solid #65b7e5;}"
+    );
+    ui->previewTextLayout->insertWidget(0, touchEditor);
+    for (QPushButton *zoom : {ui->previewZoomInButton, ui->previewZoomOutButton}) {
+        zoom->setMinimumSize(44, 40);
+        zoom->setMaximumSize(52, 44);
+        zoom->setIconSize(QSize(18, 18));
+    }
+    ui->previewScalingMode->setMinimumHeight(40);
+    ui->previewScalePercent->setMinimumWidth(56);
+    connect(touchEditor, &QPushButton::toggled, this, [this, touchEditor](bool edit) {
+        // Preserve exact prior dock visibility; leave render and encoder untouched.
+        for (QDockWidget *dock : findChildren<QDockWidget *>(QString(), Qt::FindDirectChildrenOnly)) {
+            if (edit) {
+                dock->setProperty("_abyssEditWasVisible", dock->isVisible());
+                dock->hide();
+            } else if (dock->property("_abyssEditWasVisible").isValid()) {
+                dock->setVisible(dock->property("_abyssEditWasVisible").toBool());
+                dock->setProperty("_abyssEditWasVisible", QVariant());
+            }
+        }
+        touchEditor->setText(edit ? QString::fromUtf8("Concluir edição")
+                                  : QString::fromUtf8("Ampliar edição"));
+        // Reuse the active display, fit preview after layout geometry settles.
+        QTimer::singleShot(0, this, [this] { setPreviewScalingWindow(); });
+    });
+#endif
 #ifdef __ANDROID__
     // Unlike the Ubuntu launcher, this uses Qt's native display path.
