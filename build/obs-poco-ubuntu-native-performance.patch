@@ -0,0 +1,20 @@
+// Native Android OBS: auto-hide preview while streaming/recording.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+enum class OBSAndroidPreviewAction { None, Hide, Restore };
+
+// A simple deterministic state machine. Streaming and recording can overlap;
+// closing one must not restore the preview while the other is still active.
+inline OBSAndroidPreviewAction OBSAndroidPreviewTransition(
+    bool streaming, bool recording, bool previewEnabled,
+    bool studioMode, bool autoHide, bool &suppressed)
+{
+    const bool shouldHide = (streaming || recording) && previewEnabled &&
+                            !studioMode && autoHide;
+    if (shouldHide == suppressed)
+        return OBSAndroidPreviewAction::None;
+    suppressed = shouldHide;
+    return shouldHide ? OBSAndroidPreviewAction::Hide
+                      : OBSAndroidPreviewAction::Restore;
+}
