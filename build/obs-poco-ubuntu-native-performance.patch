diff --git a/scripts/test-android-output-preview.cpp b/scripts/test-android-output-preview.cpp
new file mode 100644
index 0000000..7fc2ae2
--- /dev/null
+++ b/scripts/test-android-output-preview.cpp
@@ -0,0 +1,24 @@
+#include "../obs-studio/frontend/utility/AndroidOutputPreviewPolicy.hpp"
+#include <cassert>
+#include <iostream>
+int main()
+{
+    bool suppressed = false;
+    using A = OBSAndroidPreviewAction;
+    auto f = [&](bool streaming, bool recording, bool preview=true,
+                 bool studio=false, bool autoHide=true) {
+        return OBSAndroidPreviewTransition(streaming,recording,preview,
+                                          studio,autoHide,suppressed);
+    };
+    assert(f(false,false) == A::None);
+    assert(f(true,false) == A::Hide);
+    assert(f(true,true) == A::None);          // simultaneous live + recording
+    assert(f(false,true) == A::None);         // live stopped; still recording
+    assert(f(false,false) == A::Restore);     // both stopped
+    assert(f(false,true) == A::Hide);         // recording only
+    assert(f(false,true,true,false,false) == A::Restore); // opt-out
+    assert(f(false,true,true,false,true) == A::Hide); // opt back in
+    assert(f(false,true,true,true,true) == A::Restore); // Studio Mode
+    assert(f(false,false,false,false,true) == A::None);
+    std::cout << "PASS Android live preview state machine\n";
+}
