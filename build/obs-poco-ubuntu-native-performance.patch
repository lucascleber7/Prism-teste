+#ifdef __ANDROID__
+void OBSBasic::UpdateAndroidOutputPreview()
+{
+    const bool autoHide = config_get_bool(App()->GetUserConfig(), "BasicWindow",
+                                          "POCOAutoHidePreviewOnOutput");
+    const auto action = OBSAndroidPreviewTransition(
+        androidStreamOutputStarted, androidRecordOutputStarted, previewEnabled,
+        previewProgramMode, autoHide, androidPreviewHiddenByPerformanceMode);
+    if (action == OBSAndroidPreviewAction::Hide) {
+        EnablePreviewDisplay(false);
+        blog(LOG_INFO, "[POCO-performance] preview=off reason=live-or-recording stream=%d record=%d",
+             int(androidStreamOutputStarted), int(androidRecordOutputStarted));
+    } else if (action == OBSAndroidPreviewAction::Restore) {
+        if (!previewProgramMode)
+            EnablePreviewDisplay(previewEnabled);
+        blog(LOG_INFO, "[POCO-performance] preview=restored stream=%d record=%d",
+             int(androidStreamOutputStarted), int(androidRecordOutputStarted));
+    }
+}
+#endif
+
 void OBSBasic::TogglePreview()
 {
-	previewEnabled = !previewEnabled;
-	EnablePreviewDisplay(previewEnabled);
+#ifdef __ANDROID__
+    // If the user explicitly taps "Ativar prévia" while in performance mode,
+    // restore the preview without inverting the remembered on/off preference.
+    if (androidPreviewHiddenByPerformanceMode) {
+        androidPreviewHiddenByPerformanceMode = false;
+        EnablePreviewDisplay(previewEnabled);
+        return;
+    }
+#endif
+    previewEnabled = !previewEnabled;
+    EnablePreviewDisplay(previewEnabled);
 }
 
