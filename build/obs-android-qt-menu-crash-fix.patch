+++ b/scripts/android-touch-menu-test/CMakeLists.txt
@@ -0,0 +1,9 @@
+cmake_minimum_required(VERSION 3.20)
+project(obs_android_touch_menu_qa LANGUAGES CXX)
+find_package(Qt6 REQUIRED COMPONENTS Widgets)
+enable_testing()
+add_executable(obs_android_touch_menu_qa test.cpp)
+target_compile_features(obs_android_touch_menu_qa PRIVATE cxx_std_17)
+target_include_directories(obs_android_touch_menu_qa PRIVATE ../../obs-studio/frontend)
+target_link_libraries(obs_android_touch_menu_qa PRIVATE Qt6::Widgets)
+add_test(NAME android_touch_menu_qa COMMAND obs_android_touch_menu_qa)
diff --git a/scripts/android-touch-menu-test/test.cpp b/scripts/android-touch-menu-test/test.cpp
new file mode 100644
index 0000000..5e1d6cd
--- /dev/null
+++ b/scripts/android-touch-menu-test/test.cpp
@@ -0,0 +1,35 @@
+#include <QApplication>
+#include <QAction>
+#include <QMenu>
+#include <QSet>
+#include <QVector>
+#include <QWidgetAction>
+#include <utility/AndroidSafeMenu.hpp>
+#include <cassert>
+#include <iostream>
+int main(int argc, char **argv)
+{
+    QApplication app(argc, argv);
+    QMenu menu;
+    menu.addAction(QStringLiteral("Gravar"));
+    QMenu *submenu = menu.addMenu(QStringLiteral("Fontes"));
+    QAction *remote = submenu->addAction(QStringLiteral("Celular remoto"));
+    QAction *disabled = submenu->addAction(QStringLiteral("Desativado"));
+    disabled->setEnabled(false);
+    auto *widget = new QWidgetAction(&menu);
+    menu.addAction(widget);
+    int triggered = 0;
+    QObject::connect(remote, &QAction::triggered, [&triggered]() { ++triggered; });
+    QVector<OBSAndroidTouchMenuEntry> entries;
+    QSet<const QMenu *> visited;
+    OBSCollectAndroidTouchMenuEntries(menu, entries, visited);
+    assert(entries.size() == 3);
+    assert(entries[0].label == QStringLiteral("Gravar"));
+    assert(entries[1].label == QStringLiteral("Fontes › Celular remoto"));
+    assert(entries[2].label == QStringLiteral("Fontes › Desativado"));
+    assert(entries[1].action == remote);
+    assert(!entries[2].action->isEnabled());
+    entries[1].action->trigger();
+    assert(triggered == 1);
+    std::cout << "PASS Android OBS Qt menu flattening and QAction forwarding\n";
+}
