diff --git a/obs-studio/frontend/utility/AndroidSafeMenu.hpp b/obs-studio/frontend/utility/AndroidSafeMenu.hpp
new file mode 100644
index 0000000..186e756
--- /dev/null
+++ b/obs-studio/frontend/utility/AndroidSafeMenu.hpp
@@ -0,0 +1,127 @@
+// Android-only alternative to transient QMenu popup stacks.
+// Copyright (C) 2026 OBS POCO contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <QAbstractItemView>
+#include <QAction>
+#include <QDialog>
+#include <QDialogButtonBox>
+#include <QGuiApplication>
+#include <QLabel>
+#include <QListWidget>
+#include <QMenu>
+#include <QPointer>
+#include <QScopedValueRollback>
+#include <QScreen>
+#include <QSet>
+#include <QString>
+#include <QVBoxLayout>
+#include <QVector>
+#include <QWidgetAction>
+
+struct OBSAndroidTouchMenuEntry {
+    QString label;
+    QPointer<QAction> action;
+};
+
+inline void OBSCollectAndroidTouchMenuEntries(const QMenu &menu,
+                                               QVector<OBSAndroidTouchMenuEntry> &entries,
+                                               QSet<const QMenu *> &visited,
+                                               const QString &prefix = {}, int depth = 0)
+{
+    // QMenu/QAction graphs can share submenus. Keep the dialog finite and
+    // avoid recursively opening a menu with a delayed popup timer.
+    if (depth > 8 || visited.contains(&menu))
+        return;
+    visited.insert(&menu);
+    for (QAction *action : menu.actions()) {
+        if (!action || !action->isVisible() || action->isSeparator())
+            continue;
+        QString label = action->text();
+        label.remove(QLatin1Char('&'));
+        const QString fullName = prefix.isEmpty() ? label : prefix + QStringLiteral(" › ") + label;
+        if (const QMenu *sub = action->menu()) {
+            if (action->isEnabled())
+                OBSCollectAndroidTouchMenuEntries(*sub, entries, visited, fullName, depth + 1);
+        } else if (!qobject_cast<QWidgetAction *>(action) && !label.isEmpty()) {
+            entries.append({fullName, QPointer<QAction>(action)});
+        }
+    }
+}
+
+// Android's touch-emulated mouse hover can leave QMenu delayed submenu
+// timers active during menu destruction. A modal scrollable list does not
+// create nested QMenu popups, and preserves original QAction receivers.
+inline QAction *OBSExecAndroidTouchSafeMenu(QMenu &menu)
+{
+    static bool menuOpen = false; // GUI-thread-only, shared by all callers
+    if (menuOpen)
+        return nullptr;
+    const QScopedValueRollback<bool> guard(menuOpen, true);
+
+    QVector<OBSAndroidTouchMenuEntry> entries;
+    QSet<const QMenu *> visited;
+    OBSCollectAndroidTouchMenuEntries(menu, entries, visited);
+    if (entries.isEmpty())
+        return nullptr;
+
+    QDialog dialog(menu.parentWidget());
+    dialog.setWindowTitle(QStringLiteral("Ações do OBS"));
+    dialog.setModal(true);
+
+    auto *layout = new QVBoxLayout(&dialog);
+    auto *description = new QLabel(
+        QStringLiteral("Toque em uma ação. Para sair, toque em Cancelar."), &dialog);
+    description->setWordWrap(true);
+    layout->addWidget(description);
+    auto *actions = new QListWidget(&dialog);
+    actions->setSelectionMode(QAbstractItemView::SingleSelection);
+    actions->setVerticalScrollMode(QAbstractItemView::ScrollPerPixel);
+    layout->addWidget(actions, 1);
+
+    for (int i = 0; i < entries.size(); ++i) {
+        const auto &entry = entries.at(i);
+        auto *item = new QListWidgetItem(entry.label, actions);
+        item->setData(Qt::UserRole, i);
+        if (entry.action) {
+            item->setIcon(entry.action->icon());
+            item->setToolTip(entry.action->toolTip());
+            if (!entry.action->isEnabled())
+                item->setFlags(item->flags() & ~Qt::ItemIsEnabled);
+            if (entry.action->isCheckable())
+                item->setText((entry.action->isChecked() ? QStringLiteral("☑  ")
+                                                         : QStringLiteral("☐  ")) + entry.label);
+        } else {
+            item->setFlags(item->flags() & ~Qt::ItemIsEnabled);
+        }
+    }
+
+    auto *buttons = new QDialogButtonBox(QDialogButtonBox::Cancel, &dialog);
+    layout->addWidget(buttons);
+    QObject::connect(buttons, &QDialogButtonBox::rejected, &dialog, &QDialog::reject);
+
+    QPointer<QAction> chosen;
+    QObject::connect(actions, &QListWidget::itemClicked, &dialog, [&](QListWidgetItem *item) {
+        const int index = item->data(Qt::UserRole).toInt();
+        if (index >= 0 && index < entries.size() &&
+            entries.at(index).action && entries.at(index).action->isEnabled()) {
+            chosen = entries.at(index).action;
+            dialog.accept();
+        }
+    });
+
+    if (QScreen *screen = QGuiApplication::primaryScreen()) {
+        const QSize available = screen->availableGeometry().size();
+        dialog.resize(qMin(600, qMax(280, available.width() - 32)),
+                      qMin(620, qMax(230, available.height() - 32)));
+    }
+
+    if (dialog.exec() != QDialog::Accepted || !chosen)
+        return nullptr;
+    // Invoke after the dialog exits, so existing OBS slots get a live
+    // source QAction sender without nested QMenu event-loop lifetime risks.
+    QAction *result = chosen;
+    result->trigger();
+    return result;
+}
