diff --git a/obs-studio/frontend/widgets/OBSBasic.cpp b/obs-studio/frontend/widgets/OBSBasic.cpp
index 9728fe4..86c6295 100755
--- a/obs-studio/frontend/widgets/OBSBasic.cpp
+++ b/obs-studio/frontend/widgets/OBSBasic.cpp
@@ -183,6 +183,26 @@ OBSBasic::OBSBasic(QWidget *parent) : OBSMainWindow(parent), undo_s(ui), ui(new
         androidRecordOutputStarted = false;
         UpdateAndroidOutputPreview();
     });
+
+    // Port of Ubuntu/WebSocket GetStats diagnostics: one lightweight
+    // sample per 10 seconds while a native output is active.
+    // Never log the stream key, service URL, or user source settings.
+    QTimer *pocoMetricsTimer = new QTimer(this);
+    pocoMetricsTimer->setInterval(10000);
+    connect(pocoMetricsTimer, &QTimer::timeout, this, [this] {
+        if (!androidStreamOutputStarted && !androidRecordOutputStarted)
+            return;
+        OBSOutputAutoRelease stream = obs_frontend_get_streaming_output();
+        const int totalOutputFrames = stream ? obs_output_get_total_frames(stream) : 0;
+        const int droppedNetworkFrames = stream ? obs_output_get_frames_dropped(stream) : 0;
+        blog(LOG_INFO,
+             "[POCO-live-metrics] fps=%.2f render_total=%u render_lagged=%u "
+             "stream_output_frames=%d stream_network_dropped=%d streaming=%d recording=%d",
+             obs_get_active_fps(), obs_get_total_frames(), obs_get_lagged_frames(),
+             totalOutputFrames, droppedNetworkFrames,
+             int(androidStreamOutputStarted), int(androidRecordOutputStarted));
+    });
+    pocoMetricsTimer->start();
 #endif
 
