diff --git a/scripts/test-abyss-039-fixes.py b/scripts/test-abyss-039-fixes.py
new file mode 100644
index 0000000..9b559c4
--- /dev/null
+++ b/scripts/test-abyss-039-fixes.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""Abyss Stream 0.3.9: static regression checks for the fixes made on top of 0.3.7."""
+import re
+from pathlib import Path
+
+r = Path(__file__).resolve().parents[1]
+fe = r / "obs-studio/frontend"
+java = fe / "cmake/android/java/com/obsproject/studio"
+codec = (java / "ObsCodecCapabilities.java").read_text()
+service = (java / "ObsForegroundService.java").read_text()
+perm = (java / "ObsPermissionHost.java").read_text()
+manifest = (fe / "cmake/android/AndroidManifest.xml").read_text()
+props = (fe / "dialogs/OBSBasicProperties.cpp").read_text()
+basic = (fe / "widgets/OBSBasic.cpp").read_text()
+
+# Codec enumeration: a single source of truth, and a failure is never cached.
+assert codec.count("new MediaCodecList(MediaCodecList.REGULAR_CODECS).getCodecInfos()") == 1
+assert "private static synchronized MediaCodecInfo[] codecList()" in codec
+assert "public static synchronized String lastCodecProblem()" in codec
+assert "MediaCodecList.getCodecInfoAt(i)" in codec
+assert codec.count("codecList();") >= 4
+assert "if (list == null) return false;" in codec
+assert re.search(r"if \(all != null && all\.length > 0\) \{\s+codecs = all;", codec)
+assert '"\\nAviso: " + problem' in codec
+
+# Screen capture failure: caught, reported to the user, service stopped.
+assert "import android.widget.Toast;" in service
+assert "private void tellUser(final String message)" in service
+assert service.count("tellUser(") >= 3
+assert re.search(r"try \{\s+pending\.run\(\);\s+\} catch \(RuntimeException e\)", service)
+assert "return START_NOT_STICKY;" in service
+
+# Android 13+ media permissions: declared and requested.
+for name in ("READ_MEDIA_IMAGES", "READ_MEDIA_VIDEO", "READ_MEDIA_AUDIO"):
+    assert f'"android.permission.{name}"' in perm, name
+    assert f'<uses-permission android:name="android.permission.{name}" />' in manifest, name
+assert re.search(r"TIRAMISU\) \{\s+if \(!isGranted\(ctx, PERM_MEDIA_IMAGES\)\)", perm)
+
+# Version and backup policy.
+assert 'android:versionCode="36"' in manifest
+assert 'android:versionName="0.3.9-abyss"' in manifest
+assert 'android:allowBackup="false"' in manifest
+
