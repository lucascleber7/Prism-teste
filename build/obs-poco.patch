+/* Import is deliberately manual. Android's SAF picker reads a file once;
+ * user code is copied only into this application's private plugin directory.
+ * A plugin is executable native code and therefore needs explicit consent.
+ */
+bool importAndroidPlugin(const QString &suggestedName, const QByteArray &bytes, QWidget *parent)
+{
+    static const QRegularExpression filenamePattern(
+        QStringLiteral(R"(^[A-Za-z0-9_][A-Za-z0-9_.-]*\.so$)"));
+    const QString name = QFileInfo(suggestedName).fileName();
+    if (!filenamePattern.match(name).hasMatch() || name == QStringLiteral(".so")) {
+        QMessageBox::warning(parent, QStringLiteral("Plugin inválido"),
+                             QStringLiteral("Selecione um plugin .so para Android ARM64."));
+        return false;
+    }
+    // ELF64 little-endian shared object (ET_DYN), e_machine=AArch64 (183).
+    if (!OBS::AndroidPluginImport::isArm64SharedLibrary(
+            reinterpret_cast<const unsigned char *>(bytes.constData()),
+            static_cast<std::size_t>(bytes.size()))) {
+        QMessageBox::warning(parent, QStringLiteral("Plugin incompatível"),
+                             QStringLiteral("O arquivo precisa ser uma biblioteca ELF ARM64 de até 64 MB."));
+        return false;
+    }
+    const char *root = std::getenv("OBS_ROOT_PATH");
+    if (!root || !*root) {
+        QMessageBox::warning(parent, QStringLiteral("OBS indisponível"),
+                             QStringLiteral("O diretório privado do OBS ainda não foi inicializado."));
+        return false;
+    }
+    // Never overwrite a bundled plugin: this would change the trusted encoder/capture path.
+    const char *bundle = std::getenv("OBS_ANDROID_BUNDLED_PLUGIN_DIR");
+    if (bundle && *bundle && QFileInfo(QString::fromUtf8(bundle) + '/' + name).exists()) {
+        QMessageBox::warning(parent, QStringLiteral("Plugin protegido"),
+                             QStringLiteral("Este nome já pertence a um plugin integrado ao OBS."));
+        return false;
+    }
+    const QString pluginDir = QString::fromUtf8(root) + QStringLiteral("/lib");
+    const QString targetPath = pluginDir + '/' + name;
+    if (QFileInfo::exists(targetPath) || QFileInfo(targetPath).isSymLink()) {
+        QMessageBox::warning(parent, QStringLiteral("Plugin já existe"),
+                             QStringLiteral("Não vou substituir um plugin que já está instalado."));
+        return false;
+    }
+    if (QMessageBox::question(
+            parent, QStringLiteral("Instalar plugin externo?"),
+            QStringLiteral("Plugins .so executam código nativo com acesso aos dados do OBS. "
+                           "Use apenas arquivos confiáveis, compilados para este OBS Android ARM64. "
+                           "O plugin pode não carregar ou pode causar travamentos. Continuar?"),
+            QMessageBox::Yes | QMessageBox::No, QMessageBox::No) != QMessageBox::Yes)
+        return false;
+    if (!QDir().mkpath(pluginDir)) {
+        QMessageBox::warning(parent, QStringLiteral("Erro"), QStringLiteral("Não foi possível criar o diretório de plugins."));
+        return false;
+    }
+    QSaveFile destination(targetPath);
+    if (!destination.open(QIODevice::WriteOnly) ||
+        destination.write(bytes) != bytes.size() || !destination.commit()) {
+        destination.cancelWriting();
+        QMessageBox::warning(parent, QStringLiteral("Erro ao copiar"),
+                             QStringLiteral("Não foi possível salvar o plugin na pasta privada do OBS."));
+        return false;
+    }
+    QMessageBox::information(parent, QStringLiteral("Plugin importado"),
+                             QStringLiteral("O arquivo foi copiado. Reinicie o OBS para tentar carregá-lo. "
+                                            "A compatibilidade só poderá ser confirmada após reiniciar."));
+    return true;
+}
+#endif
+
 } // namespace
 
 namespace OBS {
@@ -91,6 +179,52 @@ PluginManagerWindow::PluginManagerWindow(std::vector<ModuleInfo> const &modules,
 
 	setupInstalledPage(failedModules);
 
+#if defined(Q_OS_ANDROID)
+    // The APK's built-in plugins are immutable. Import is optional and never
+    // overwrites them; it is available through the installed-plugins page.
+    auto *androidImport = new QPushButton(QStringLiteral("Importar plugin ARM64 (.so)"), this);
+    androidImport->setObjectName(QStringLiteral("androidPluginImportButton"));
+    ui->installedPage->layout()->addWidget(androidImport);
+    connect(androidImport, &QPushButton::clicked, this, [this]() {
+        QPointer<PluginManagerWindow> dialog(this);
+        QFileDialog::getOpenFileContent(QStringLiteral("Plugin OBS (*.so)"),
+                                        [dialog](const QString &fileName, const QByteArray &contents) {
+            if (dialog && !fileName.isEmpty())
+                importAndroidPlugin(fileName, contents, dialog.data());
+        }, this);
+    });
+
+    auto *androidReport = new QPushButton(QStringLiteral("Copiar diagnóstico de fontes e plugins"), this);
+    androidReport->setObjectName(QStringLiteral("androidPluginReportButton"));
+    ui->installedPage->layout()->addWidget(androidReport);
+    connect(androidReport, &QPushButton::clicked, this, [this, failedModules]() {
+        QString report = QStringLiteral("OBS for Android - Diagnóstico de módulos\n");
+        report += QStringLiteral("Plugins listados: %1\n").arg(modules_.size());
+        for (const auto &module : modules_) {
+            report += QStringLiteral("- %1 (%2)\n")
+                          .arg(QString::fromStdString(module.module_name),
+                               module.enabledAtLaunch ? QStringLiteral("ativo") : QStringLiteral("desativado"));
+        }
+        for (const auto &name : failedModules)
+            report += QStringLiteral("ERRO: %1\n").arg(QString::fromStdString(name));
+        report += QStringLiteral("Tipos de fonte registrados:\n");
+        const char *sourceId = nullptr;
+        for (size_t index = 0; obs_enum_source_types(index, &sourceId); ++index) {
+            if (sourceId)
+                report += QStringLiteral("- %1\n").arg(QString::fromUtf8(sourceId));
+        }
+        if (QGuiApplication::clipboard()) {
+            QGuiApplication::clipboard()->setText(report);
+            QMessageBox::information(this, QStringLiteral("Diagnóstico de plugins"),
+                                     QStringLiteral("Lista de plugins e fontes copiada. "
+                                                    "Não inclui senhas ou chaves de transmissão."));
+        } else {
+            QMessageBox::warning(this, QStringLiteral("Diagnóstico"),
+                                 QStringLiteral("Não foi possível acessar a área de transferência."));
+        }
+    });
+#endif
+
 	setPage(Page::Installed);
 
 	ui->manageRestartLabel->setVisible(isEnabledPluginsChanged());
