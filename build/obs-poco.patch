new file mode 100644
index 0000000..b4ceeef
--- /dev/null
+++ b/obs-studio/frontend/plugin-manager/AndroidPluginImportValidation.hpp
@@ -0,0 +1,25 @@
+/*
+ * OBS for Android: validation of imported ARM64 shared objects.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace OBS::AndroidPluginImport {
+
+inline constexpr std::size_t maxPluginBytes = 64u * 1024u * 1024u;
+
+inline bool isArm64SharedLibrary(const unsigned char *data, std::size_t size)
+{
+    if (!data || size < 64 || size > maxPluginBytes)
+        return false;
+
+    // ELF64 little-endian, type ET_DYN, CPU AArch64.
+    return data[0] == 0x7f && data[1] == 'E' && data[2] == 'L' && data[3] == 'F' &&
+           data[4] == 2 && data[5] == 1 && data[16] == 3 && data[17] == 0 &&
+           data[18] == 183 && data[19] == 0;
+}
+
+} // namespace OBS::AndroidPluginImport
