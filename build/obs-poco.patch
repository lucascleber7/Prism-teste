diff --git a/scripts/test-android-plugin-import.cpp b/scripts/test-android-plugin-import.cpp
new file mode 100644
index 0000000..825acd3
--- /dev/null
+++ b/scripts/test-android-plugin-import.cpp
@@ -0,0 +1,33 @@
+/*
+ * Portable unit tests for the Android plugin importer ELF validation.
+ * Run: clang++ -std=c++17 -Wall -Wextra -Werror -Iobs-studio/frontend/plugin-manager
+ *      scripts/test-android-plugin-import.cpp -o /tmp/test-android-plugin-import
+ */
+#include "../obs-studio/frontend/plugin-manager/AndroidPluginImportValidation.hpp"
+#include <array>
+#include <cassert>
+#include <cstdint>
+#include <iostream>
+
+int main()
+{
+    using namespace OBS::AndroidPluginImport;
+    std::array<unsigned char, 64> so{};
+    so[0]=0x7f; so[1]='E'; so[2]='L'; so[3]='F';
+    so[4]=2; so[5]=1; so[16]=3; so[17]=0; so[18]=183; so[19]=0;
+    assert(isArm64SharedLibrary(so.data(),so.size()));
+    assert(!isArm64SharedLibrary(nullptr, so.size()));
+    assert(!isArm64SharedLibrary(so.data(),19));
+    assert(!isArm64SharedLibrary(so.data(),maxPluginBytes+1));
+    auto invalid=so;
+    invalid[4]=1; // 32-bit ELF
+    assert(!isArm64SharedLibrary(invalid.data(), invalid.size()));
+    invalid=so; invalid[18]=62; // x86_64 ELF
+    assert(!isArm64SharedLibrary(invalid.data(), invalid.size()));
+    invalid=so; invalid[16]=2; // ET_EXEC
+    assert(!isArm64SharedLibrary(invalid.data(), invalid.size()));
+    invalid=so; invalid[0]=0; // not an ELF file
+    assert(!isArm64SharedLibrary(invalid.data(), invalid.size()));
+    std::cout<<"PASS Android OBS plugin ELF validation\n";
+    return 0;
+}
