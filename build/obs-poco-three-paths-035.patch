+#!/usr/bin/env python3
+"""Static integration guards: Android overlays must retain transparency."""
+from pathlib import Path
+r = Path(__file__).resolve().parents[1]
+p = r/"obs-studio"
+browser = (p/"plugins/android-browser/browser-source.c").read_text()
+web = (p/"frontend/cmake/android/java/com/obsproject/studio/ObsBrowserHost.java").read_text()
+drop = (p/"frontend/widgets/OBSBasic_Dropfiles.cpp").read_text()
+scenes = (p/"frontend/widgets/OBSBasic_SceneCollections.cpp").read_text()
+controls = (p/"frontend/widgets/OBSBasicControls.cpp").read_text()
