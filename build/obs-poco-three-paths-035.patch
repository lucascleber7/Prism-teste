+#!/usr/bin/env python3
+"""Regression: all three POCO native OBS video paths must remain wired."""
+from pathlib import Path
+r=Path(__file__).resolve().parents[1]
+p=r/"obs-studio"
+cm=(p/"plugins/CMakeLists.txt").read_text()
+gl=(p/"libobs-opengl/gl-android.c").read_text()
+basic=(p/"frontend/widgets/OBSBasic.cpp").read_text()
+controls=(p/"frontend/widgets/OBSBasicControls.cpp").read_text()
+signals=(p/"frontend/widgets/OBSBasicControls.hpp").read_text()
+simple=(p/"frontend/utility/SimpleOutput.cpp").read_text()
+codec=(p/"plugins/android-mediacodec/android-mediacodec.c").read_text()
+java=(p/"frontend/cmake/android/java/com/obsproject/studio/ObsCodecCapabilities.java").read_text()
+assert "add_subdirectory(obs-x264)" in cm
+assert "add_subdirectory(android-mediacodec)" in cm
+assert "eglBindAPI(EGL_OPENGL_ES_API)" in gl
+assert "eglGetDisplay(EGL_DEFAULT_DISPLAY)" in gl
+assert "gladLoadGLES2(get_proc_address)" in gl
+assert 'CAMINHO 1 — GPU OpenGL ES (EGL)' in basic
+assert 'CAMINHO 2 — MediaCodec H.264 hardware' in basic
+assert 'CAMINHO 3 — CPU x264 software' in basic
+assert 'Vulkan: a GPU pode suportar, mas NÃO é o backend deste APK' in basic
+assert 'pocoThreePathsReportAction' in basic
+assert "POCOQuickPerformanceClicked" in signals and "POCOQuickPerformanceClicked" in controls
+assert 'pocoQuickPerformanceButton' in controls
+assert 'EncoderAvailable("obs_x264")' in basic
+assert 'EncoderAvailable("android_mediacodec_h264")' in basic
+assert 'ResetOutputs(); // Force the effective OBS output encoder' in basic
+assert 'SIMPLE_ENCODER_ANDROID_MEDIACODEC' in simple
+assert 'return "obs_x264"' in simple
+assert 'value && *value ? value : "ultrafast"' in simple
+assert 'AMediaCodec_start(e->codec)' in codec
+assert 'hardware=true software=false input=Surface' in codec
+assert 'isHardwareAccelerated()' in java and 'isSoftwareOnly()' in java
+assert 'findEncodersMode("video/avc"' in java
+print("PASS 3 paths: EGL/GLES3 rendering, MediaCodec HW, x264 SW fallback, UI and status guards")
