index 0000000..85698a1
--- /dev/null
+++ b/obs-studio/frontend/cmake/android/java/com/obsproject/studio/ObsCrashDiag.java
@@ -0,0 +1,191 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+package com.obsproject.studio;
+
+import android.app.ActivityManager;
+import android.app.ApplicationExitInfo;
+import android.content.ContentValues;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.content.pm.PackageInfo;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Environment;
+import android.provider.MediaStore;
+import android.util.Log;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Leaves a small text file in Downloads when the app dies unexpectedly, so the cause can be read
+ * after the next launch without adb: uncaught Java exceptions are written at the moment they
+ * happen, and the system's record of how the previous process ended (native crash, ANR, memory
+ * kill...) is written at startup. Every entry point swallows its own errors: diagnostics must
+ * never become a new crash.
+ */
+public final class ObsCrashDiag {
+    private static final String TAG = "ObsCrashDiag";
+    private static final String PREFS = "abyss_diag";
+    private static final String KEY_LAST_EXIT = "last_exit_ms";
+    private static final String KEY_FILES = "files_written";
+    private static final int MAX_FILES = 30;
+    private static boolean installed;
+
+    private ObsCrashDiag() {}
+
+    /** Idempotent and cheap after the first call. */
+    public static synchronized void install(Context context) {
+        if (installed || context == null) return;
+        installed = true;
+        try {
+            final Context app = context.getApplicationContext() != null ? context.getApplicationContext() : context;
+            final Thread.UncaughtExceptionHandler previous = Thread.getDefaultUncaughtExceptionHandler();
+            Thread.setDefaultUncaughtExceptionHandler(new Thread.UncaughtExceptionHandler() {
+                @Override
+                public void uncaughtException(Thread thread, Throwable error) {
+                    try {
+                        write(app, "crash-java", "Thread: " + thread.getName() + "\n" + Log.getStackTraceString(error));
+                    } catch (Throwable ignored) {
+                        // Nothing more can be done while the process is already dying.
+                    }
+                    if (previous != null) previous.uncaughtException(thread, error);
+                }
+            });
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+                Thread worker = new Thread(new Runnable() {
+                    @Override
+                    public void run() {
+                        try {
+                            ExitReader.record(app);
+                        } catch (Throwable t) {
+                            Log.w(TAG, "exit reasons not recorded", t);
+                        }
+                    }
+                }, "abyss-exit-info");
+                worker.setDaemon(true);
+                worker.start();
+            }
+        } catch (Throwable t) {
+            Log.w(TAG, "diagnostics not installed", t);
+        }
+    }
+
+    /** Kept in its own class so devices below API 30 never try to load ApplicationExitInfo. */
+    private static final class ExitReader {
+        static void record(Context app) throws Exception {
+            ActivityManager manager = (ActivityManager) app.getSystemService(Context.ACTIVITY_SERVICE);
+            if (manager == null) return;
+            SharedPreferences prefs = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+            long lastSeen = prefs.getLong(KEY_LAST_EXIT, 0L);
+            long newest = lastSeen;
+            StringBuilder report = new StringBuilder();
+            List<ApplicationExitInfo> exits = manager.getHistoricalProcessExitReasons(null, 0, 8);
+            for (ApplicationExitInfo info : exits) {
+                long when = info.getTimestamp();
+                if (when <= lastSeen) continue;
+                if (when > newest) newest = when;
+                int reason = info.getReason();
+                if (reason == ApplicationExitInfo.REASON_USER_REQUESTED
+                        || reason == ApplicationExitInfo.REASON_USER_STOPPED
+                        || reason == ApplicationExitInfo.REASON_PACKAGE_UPDATED) continue;
+                if (reason == ApplicationExitInfo.REASON_EXIT_SELF && info.getStatus() == 0) continue;
+                report.append(new SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.US).format(new Date(when)))
+                      .append("  processo=").append(info.getProcessName())
+                      .append("  motivo=").append(reasonName(reason))
+                      .append("  status=").append(info.getStatus())
+                      .append("  importancia=").append(info.getImportance())
+                      .append("  rss_kb=").append(info.getRss())
+                      .append("\n  descricao=").append(info.getDescription()).append('\n');
+                if (reason == ApplicationExitInfo.REASON_ANR) report.append(readTrace(info));
+            }
+            prefs.edit().putLong(KEY_LAST_EXIT, newest).apply();
+            if (report.length() > 0) write(app, "saida-anterior", report.toString());
+        }
+
+        private static String readTrace(ApplicationExitInfo info) {
+            try (InputStream in = info.getTraceInputStream()) {
+                if (in == null) return "";
+                byte[] buffer = new byte[6000];
+                int n = in.read(buffer);
+                return n > 0 ? "  trace_anr:\n" + new String(buffer, 0, n, StandardCharsets.UTF_8) + "\n" : "";
+            } catch (Throwable t) {
+                return "";
+            }
+        }
+
+        private static String reasonName(int reason) {
+            switch (reason) {
+            case ApplicationExitInfo.REASON_ANR: return "ANR (app travado)";
+            case ApplicationExitInfo.REASON_CRASH: return "CRASH Java";
+            case ApplicationExitInfo.REASON_CRASH_NATIVE: return "CRASH NATIVO (SIGSEGV/abort)";
+            case ApplicationExitInfo.REASON_LOW_MEMORY: return "FECHADO POR FALTA DE MEMORIA";
+            case ApplicationExitInfo.REASON_SIGNALED: return "MORTO POR SINAL (sistema/bateria)";
+            case ApplicationExitInfo.REASON_EXCESSIVE_RESOURCE_USAGE: return "USO EXCESSIVO DE RECURSOS";
+            case ApplicationExitInfo.REASON_INITIALIZATION_FAILURE: return "FALHA AO INICIAR";
+            case ApplicationExitInfo.REASON_PERMISSION_CHANGE: return "PERMISSAO ALTERADA";
+            case ApplicationExitInfo.REASON_DEPENDENCY_DIED: return "DEPENDENCIA MORREU";
+            case ApplicationExitInfo.REASON_FREEZER: return "CONGELADO PELO SISTEMA";
+            case ApplicationExitInfo.REASON_EXIT_SELF: return "SAIU POR CONTA PROPRIA (status != 0)";
+            case ApplicationExitInfo.REASON_OTHER: return "OUTRO";
+            default: return "DESCONHECIDO(" + reason + ")";
+            }
+        }
+    }
+
+    @SuppressWarnings("deprecation")
+    private static String header(Context app) {
+        String version = "?";
+        try {
+            PackageInfo info = app.getPackageManager().getPackageInfo(app.getPackageName(), 0);
+            version = info.versionName + " (" + info.versionCode + ")";
+        } catch (Throwable ignored) {
+            // Header only; the report is still useful without it.
+        }
+        return "Abyss Stream " + version + "\nAndroid " + Build.VERSION.RELEASE + " (API " + Build.VERSION.SDK_INT + ")\n"
+            + Build.MANUFACTURER + " " + Build.MODEL;
+    }
+
+    /** Public Downloads through MediaStore (no permission needed); private storage as a fallback. */
+    private static void write(Context app, String tag, String body) {
+        SharedPreferences prefs = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        int written = prefs.getInt(KEY_FILES, 0);
+        if (written >= MAX_FILES) return;
+        prefs.edit().putInt(KEY_FILES, written + 1).apply();
+        String stamp = new SimpleDateFormat("yyyyMMdd_HHmmss", Locale.US).format(new Date());
+        String name = "ABYSS_STREAM_diag_" + tag + "_" + stamp + ".txt";
+        byte[] data = (header(app) + "\n\n" + body + "\n").getBytes(StandardCharsets.UTF_8);
+        try {
+            ContentValues values = new ContentValues();
+            values.put(MediaStore.MediaColumns.DISPLAY_NAME, name);
+            values.put(MediaStore.MediaColumns.MIME_TYPE, "text/plain");
+            values.put(MediaStore.MediaColumns.RELATIVE_PATH, Environment.DIRECTORY_DOWNLOADS);
+            Uri uri = app.getContentResolver().insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, values);
+            if (uri != null) {
+                try (OutputStream out = app.getContentResolver().openOutputStream(uri)) {
+                    if (out != null) {
+                        out.write(data);
+                        return;
+                    }
+                }
+            }
+        } catch (Throwable t) {
+            Log.w(TAG, "MediaStore write failed, using private storage", t);
+        }
+        try {
+            File dir = new File(app.getFilesDir(), "diag");
+            if (dir.isDirectory() || dir.mkdirs()) {
+                try (FileOutputStream out = new FileOutputStream(new File(dir, name))) {
+                    out.write(data);
+                }
+            }
+        } catch (Throwable t) {
+            Log.w(TAG, "private write failed", t);
+        }
+    }
+}
