diff --git a/scripts/test-abyss-0310-fixes.py b/scripts/test-abyss-0310-fixes.py
new file mode 100644
index 0000000..2b0df14
--- /dev/null
+++ b/scripts/test-abyss-0310-fixes.py
@@ -0,0 +1,35 @@
+#!/usr/bin/env python3
+"""Abyss Stream 0.3.10: crash diagnostics and the foreground-service contract."""
+import re
+from pathlib import Path
+
+r = Path(__file__).resolve().parents[1]
+java = r / "obs-studio/frontend/cmake/android/java/com/obsproject/studio"
+diag = (java / "ObsCrashDiag.java").read_text()
+net = (java / "ObsNetworkStatus.java").read_text()
+service = (java / "ObsForegroundService.java").read_text()
+manifest = (r / "obs-studio/frontend/cmake/android/AndroidManifest.xml").read_text()
+
+# Diagnostics: installed on every launch, never able to crash the app, still lets the system see the crash.
+assert "public static synchronized void install(Context context)" in diag
+assert "Thread.setDefaultUncaughtExceptionHandler" in diag
+assert "previous.uncaughtException(thread, error)" in diag
+assert "getHistoricalProcessExitReasons" in diag
+assert "private static final class ExitReader" in diag
+assert "Build.VERSION_CODES.R" in diag
+assert "MediaStore.Downloads.EXTERNAL_CONTENT_URI" in diag
+assert "MAX_FILES" in diag
+assert "ObsCrashDiag.install(context);" in net
+assert net.index("ObsCrashDiag.install(context);") < net.index("if (context == null) return")
+
+# startForegroundService() must always be answered with startForeground(), or the system kills the app.
+assert "private void satisfyForegroundContract()" in service
+assert re.search(
+    r"final boolean promoted = promoteToForeground\(\);\s+if \(!promoted\) \{\s+satisfyForegroundContract\(\);\s+stopSelf\(startId\);",
+    service)
+assert "FOREGROUND_SERVICE_TYPE_SPECIAL_USE);\n            } else {\n                startForeground(NOTIF_ID, minimal);" in service
+
+assert 'android:versionCode="37"' in manifest
+assert 'android:versionName="0.3.10-abyss"' in manifest
+
+print("PASS Abyss Stream 0.3.10: crash diagnostics, foreground-service contract")
