+    /**
+     * startForegroundService() obliges the service to call startForeground() within a few seconds,
+     * otherwise the system kills the whole app, which looks like the app closing by itself. When the
+     * typed promotion failed, promote with the least demanding form so the contract is still met;
+     * the caller stops the service right after.
+     */
+    private void satisfyForegroundContract() {
+        try {
+            final Notification minimal = buildNotification();
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE) {
+                startForeground(NOTIF_ID, minimal, ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE);
+            } else {
+                startForeground(NOTIF_ID, minimal);
+            }
+        } catch (Throwable t) {
+            Log.e(TAG, "minimal startForeground also failed: " + t, t);
+        }
+    }
+
