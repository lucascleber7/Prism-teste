# Copie para .env no SERVIDOR e preencha:  cp .env.example .env
# NUNCA envie o .env para o GitHub e não cole a chave em conversas: quem tem a chave transmite no seu canal.

# Endereço RTMP + chave, como o painel do Restream mostra ("RTMP URL" / "Stream Key"), juntos com uma barra:
STREAM_URL=rtmp://live.restream.io/live/COLE_A_CHAVE_DO_RESTREAM_AQUI

# Seu @ do TikTok (sem o @). É lido UMA vez daqui; sem ele o jogo vai ao ar mas não reage à live.
TIKTOK_USER=

# Vídeo. 1080x1920 a 60 fps precisa de bastante CPU; se o log mostrar speed abaixo de 1.0x, use 720x1280 e 30.
WIDTH=1080
HEIGHT=1920
FPS=60
VIDEO_BITRATE=6000k
X264_PRESET=veryfast

# Opcional: chave da Euler Stream (servidor de assinatura usado pela biblioteca do TikTok) para limites maiores.
EULER_API_KEY=

# Só para teste, NUNCA numa live real: 1 = espectadores falsos.
DEMO=0
